    {
      "name": "02 - Get all users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
              "const body = pm.response.json();",
              "pm.test(\"Returns a list\", function () { pm.expect(body).to.be.an(\"array\"); });",
              "pm.test(\"List includes created user\", function () { pm.expect(body.some(u => u.user_id === Number(pm.environment.get(\"user_id\")))).to.eql(true); });"
            ]
          }
        }
